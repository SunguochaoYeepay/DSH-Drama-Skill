# Copy to .env in the repository root. Do not commit credentials.
# 剧本与导演模型：接受任意非空模型名，不再设白名单。
# ⚠ 默认用不到：剧本和导演稿默认由当前对话的 Agent 直写（register-agent / register-direction）。
# 只有显式调用 `cli/script.mjs generate` 或 `cli/direct.mjs` 时才读下面两项。
# 出稿用什么模型由这里决定；请求与响应必须是同一个模型，票据照常记录。
AIH_SCRIPT_MODEL=qwen3.8-max
AIH_DIRECTOR_MODEL=qwen3.8-max
AIH_SCRIPT_MAX_OUTPUT_TOKENS=6000
AIH_DIRECTOR_MAX_OUTPUT_TOKENS=12000
AIH_BAILIAN_TEXT_TIMEOUT_SECONDS=600
# 可选：导演流式 Responses 优先读取下列配置；未设置时读取现有 bl 本机配置。
# AIH_BAILIAN_API_KEY=
# AIH_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
# 生图默认走本地 ComfyUI（comfyui）。线上通道是显式覆盖项，需要时才填。
AIH_ASSET_PROVIDER=comfyui
AIH_ASSET_IMAGE_MODEL=qwen-image-3.0
AIH_KEYFRAME_PROVIDER=comfyui
AIH_KEYFRAME_IMAGE_MODEL=qwen-image-3.0-pro
# 火山方舟 Seedream（使用前填写 API Key；不要提交真实密钥）
# AIH_VOLCENGINE_API_KEY=
# AIH_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com
AIH_VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5-251128
AIH_HUIMENG_IMAGE_MODEL=image-2-official
AIH_KEYFRAME_SIZE=2k
# Bailian accepts pixel dimensions; AIH_KEYFRAME_SIZE is the Huimeng resolution.
AIH_BAILIAN_KEYFRAME_SIZE=1024*1792
AIH_LOCAL_IMAGE_STEPS=20
AIH_LOCAL_IMAGE_CFG=4
AIH_VIDEO_QUALITY=normal
AIH_VIDEO_PROFILE=fast
AIH_VIDEO_ATTENTION=vsa
AIH_VIDEO_NORMAL_SIZE=480x864
AIH_VIDEO_HIGH_SIZE=768x1344
AIH_VIDEO_TIMEOUT_SECONDS=600
# ── 本机才知道、工程不猜的两项（2026-09-22 起源码里不再带任何本机路径）──────
# 缺了会怎样：`node cli/doctor.mjs` 会报 missing；真跑到生图/生视频时才会有明确报错。
# 必填：ComfyUI 自带的那份 python.exe（不是系统 Python，它缺 ComfyUI 的依赖）。
AIH_PYTHON=<你的 ComfyUI 目录>/python/python.exe
# COMFYUI_URL=http://127.0.0.1:8188
# ── 逃生口：平时用不到，换机器/换工具位置时才开 ────────────────────────────
# AIH_GEN=<comfy-studio>/gen.py                 # 默认用仓内 vendor/comfy-studio/gen.py
# AIH_BAILIAN_ENTRY=<node_modules>/bailian-cli/dist/bailian.mjs
# AIH_FFMPEG=<ffmpeg.exe>                       # 默认扫 winget 目录，再退回 PATH 上的 ffmpeg
# DRAMACLAW_ENV=<DramaClaw>/.env                # 只有 cli/huimeng.mjs 要复用外库的图床凭据时
# ── 线上通道的凭据（不要提交真实密钥）────────────────────────────────────
# AIH_VOLCENGINE_API_KEY=
# HUIMENGI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
